[Unit]
Description=AgentByte - AI API Gateway Platform
Documentation=https://github.com/mikecdd19891107-spec/agentbyte
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=agentbyte
Group=agentbyte
WorkingDirectory=/opt/agentbyte
ExecStart=/opt/agentbyte/agentbyte
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentbyte

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/agentbyte

# Environment - Server configuration
# Modify these values to change listen address and port
Environment=GIN_MODE=release
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=8080

[Install]
WantedBy=multi-user.target
